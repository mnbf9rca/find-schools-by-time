{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "routing_date", "routing_time", "timezone", "motis_version", "modes",
    "cap_seconds", "display_band_minutes", "unreachable", "compression", "rounding",
    "cycling_speed_mps", "pruning_radii_km", "origin_count", "origins_sha256",
    "school_count", "school_index_sha256", "feeds", "run", "shards", "keys"
  ],
  "properties": {
    "version": {"type": "string"},
    "routing_date": {"type": "string"},
    "routing_time": {"type": "string"},
    "timezone": {"type": "string"},
    "motis_version": {"type": "string"},
    "modes": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "string", "enum": ["public_transport", "walking", "cycling", "driving"]}
    },
    "cap_seconds": {"type": "integer", "enum": [5400]},
    "display_band_minutes": {"type": "integer", "enum": [10]},
    "unreachable": {"type": "integer", "enum": [65535]},
    "compression": {"type": "string", "enum": ["none"]},
    "rounding": {"type": "string", "enum": ["half up to whole seconds, then compared with 5400"]},
    "cycling_speed_mps": {"type": "number"},
    "pruning_radii_km": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": ["number", "null"]}},
    "origin_count": {"type": "integer"},
    "origins_sha256": {"type": "string"},
    "school_count": {"type": "integer"},
    "school_index_sha256": {"type": "string"},
    "shards": {
      "type": "object", "additionalProperties": false,
      "required": ["records_per_shard", "count", "record_bytes"],
      "properties": {
        "records_per_shard": {"type": "integer"},
        "count": {"type": "integer"}, "record_bytes": {"type": "integer"}
      }
    },
    "keys": {
      "type": "object", "additionalProperties": false,
      "required": ["shard", "origins", "manifest", "current"],
      "properties": {
        "shard": {"type": "string"}, "origins": {"type": "string"},
        "manifest": {"type": "string"}, "current": {"type": "string"}
      }
    },
    "feeds": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {"path": {"type": "string"}, "sha256": {"type": "string"}}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["started", "wall_seconds", "workers", "requests", "peak_server_rss_bytes", "output_bytes"],
      "properties": {
        "started": {"type": "string"},
        "wall_seconds": {"type": "number"},
        "workers": {"type": "integer"},
        "requests": {"type": "integer"},
        "peak_server_rss_bytes": {"type": "integer"},
        "output_bytes": {"type": "integer"},
        "requests_retried": {"type": "integer"},
        "transpose_seconds": {"type": "number"},
        "schools_completed": {"type": "integer"},
        "school_bytes": {"type": "integer"},
        "record_bytes": {"type": "integer"},
        "walk_missing_pairs": {"type": "integer"},
        "walk_nearby_pairs": {"type": "integer"}
      }
    }
  }
}
